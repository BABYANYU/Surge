#!name=Codex
#!desc=查询Codex 5小时与周额度
#!arguments=AccessToken,AccountId,Policy:Proxy
#!arguments-desc=AccessToken：短期 access_token 本身，不含 Bearer；AccountId：匹配的 ChatGPT 账户/工作区 ID。标准 JWT 和常见账户 ID 可原样填写；其他字符及 Policy 中的空格、中文、引号、逗号、&、=、% 等须先用 encodeURIComponent 编码（空格用 %20，不能用 +）。Surge 原样替换参数，不自动转义；禁止直接填写引号或换行。凭据保存在本地模块实例，勿分享模块设置或导出配置。Policy 填现有策略名，默认 Proxy。

[Panel]
Codex = title="Codex",content="请在模块设置填写 AccessToken / AccountId，点击刷新",icon=terminal,icon-color=#8EAFE0,script-name=codex-panel,update-interval=-1

[Script]
codex-panel = type=generic,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/refs/heads/main/scripts/codex-panel.js?v=20261018-layout2,timeout=15,script-update-interval=1,argument="AccessToken={{{AccessToken}}}&AccountId={{{AccountId}}}&Policy={{{Policy}}}"

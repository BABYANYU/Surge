#!name=IPPure
#!desc=使用 IPPure 查询当前 Surge 出口 IP、位置、ASN、风险分及原生 IP 状态
#!system=ios

[Panel]
IPPure = title="IPPure",content="点击刷新获取当前出口 IP",icon=network,icon-color=#64D2FF,script-name=ippure-panel-v12,update-interval=-1

[Script]
ippure-panel-v12 = type=generic,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/ippure-panel-v12.js,timeout=15,script-update-interval=3600

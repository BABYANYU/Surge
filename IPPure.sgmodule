#!name=IPPure IP 纯净度
#!desc=使用 IPPure 查询当前 Surge 出口 IP、位置、ASN、风险分及原生 IP 状态
#!system=ios

[Panel]
IPPure = title="IPPure · IP 纯净度",content="点击刷新获取当前出口 IP",icon=network.badge.shield.half.filled,icon-color=#30D158,script-name=ippure-panel,update-interval=300

[Script]
ippure-panel = type=generic,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/ippure-panel.js,timeout=10,script-update-interval=3600

[Panel]
IPPure = title="IPPure",content="点击刷新获取当前出口 IP",icon=network,icon-color=#6699FF,script-name=ippure-panel,update-interval=-1

[Script]
ippure-panel = type=generic,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/ippure-panel.js,timeout=15,script-update-interval=1

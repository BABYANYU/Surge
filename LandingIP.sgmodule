#!name=Proxy Route
#!desc=查看代理策略、入口 IP、落地 IP、服务商与位置
#!system=ios

[Panel]
Proxy Route = title="Proxy Route",content="点击刷新查询代理链路",icon=globe.asia.australia,icon-color=#6699FF,script-name=proxy-chain-panel,update-interval=-1

[Script]
proxy-chain-panel = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/landing-ip-panel.js,script-update-interval=1

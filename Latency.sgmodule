#!name=HTTPS
#!desc=点击后预热 1 轮并丢弃，再正式测试 5 轮 HTTPS；综合延迟取中位数，抖动取 MAD，提示失败样本和秒级高值。
#!system=ios
#!arguments=Group:Proxy
#!arguments-desc=填写需要检测的策略组名称，名称必须与 Surge 完全一致。

[Panel]
HTTPS = title="HTTPS",content="点击刷新检测 {{{Group}}} 组节点",icon=gauge.with.dots.needle.67percent,icon-color=#6699FF,script-name=latency-panel,update-interval=-1

[Script]
latency-panel = type=generic,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/latency-panel.js,timeout=60,script-update-interval=1,argument="{{{Group}}}"

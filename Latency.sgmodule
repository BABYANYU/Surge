#!name=Latency
#!desc=连续测试 5 轮取综合延迟与抖动。综合延迟为 TCP RTT＋代理握手＋HTTP TTFB；延迟取中位数，抖动取 MAD。
#!system=ios
#!arguments=Group:Proxy
#!arguments-desc=填写需要检测的策略组名称，名称必须与 Surge 完全一致。
#!category=Yanyu宝宝小可爱
#!icon=https://raw.githubusercontent.com/BABYANYU/Surge/main/assets/yanyu-category.jpg

[Panel]
Latency = title="Latency",content="点击刷新检测 {{{Group}}} 组节点",icon=gauge.with.dots.needle.67percent,icon-color=#6699FF,script-name=latency-panel,update-interval=-1

[Script]
latency-panel = type=generic,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/latency-panel.js,timeout=60,script-update-interval=1,argument="{{{Group}}}"

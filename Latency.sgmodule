#!name=Latency
#!desc=Proxy 组节点连续测试 5 轮：综合延迟＝握手耗时＋响应耗时；延迟取中位数，抖动取 MAD。
#!system=ios

[Panel]
Latency = title="LATENCY",content="点击刷新检测 Proxy 组节点",icon=gauge.with.dots.needle.67percent,icon-color=#6699FF,script-name=latency-panel,update-interval=-1

[Script]
latency-panel = type=generic,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/latency-panel.js,timeout=60,script-update-interval=1

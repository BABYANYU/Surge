#!name=美团（修复版）
#!desc=去广告，移除会导致商品页面反复重试和加载缓慢的 IP 段、HTTPDNS 与 QUIC 拦截；保留广告 SDK 域名拦截和页面精简。

[Rule]
DOMAIN,shark-mt.meituan.com,REJECT,extended-matching
DOMAIN,shark-default.meituan.com,REJECT,extended-matching
DOMAIN,shark-dp.meituan.com,REJECT,extended-matching
DOMAIN,shark-ps.meituan.com,REJECT,extended-matching
DOMAIN,shark-wm.sankuai.com,REJECT,extended-matching
DOMAIN,shark.dianping.com,REJECT,extended-matching

[Script]
MT-1 = type=http-response,pattern=^https?://apimobile\.meituan\.com/aggroup/indexTab,script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/6bb62bec15a36719ef4acc9ad9252f60055259a6/MT.js,requires-body=true
MT-2 = type=http-response,pattern=^https?://feedguess\.meituan\.com/lycoris/scene/(gwc_feed1_2265|personalcenter_2154)(\?|$),script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/6bb62bec15a36719ef4acc9ad9252f60055259a6/MT.js,requires-body=true
MT-3 = type=http-response,pattern=^https?://mt-personalcenter\.meituan\.com/usercenter/display,script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/6bb62bec15a36719ef4acc9ad9252f60055259a6/MT.js,requires-body=true
MT-4 = type=http-response,pattern=^https?://apimobile\.meituan\.com/group/v1/deal/searchpage/defaultword,script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/6bb62bec15a36719ef4acc9ad9252f60055259a6/MT.js,requires-body=true
MT-5 = type=http-response,pattern=^https?://apimobile\.meituan\.com/group/v1/deal/searchpage/hotword/city/divide/hotrecommend/,script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/6bb62bec15a36719ef4acc9ad9252f60055259a6/MT.js,requires-body=true
MT-6 = type=http-response,pattern=^https?://assistify\.meituan\.com/assistant/getAppClientHornConfig,script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/6bb62bec15a36719ef4acc9ad9252f60055259a6/MT.js,requires-body=true
MT-7 = type=http-response,pattern=^https?://mop\.meituan\.com/mop/entry/shoppingCartEntry,script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/6bb62bec15a36719ef4acc9ad9252f60055259a6/MT.js,requires-body=true
MT-8 = type=http-response,pattern=^https?://mop\.meituan\.com/api/entryModule/startupPicture,script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/6bb62bec15a36719ef4acc9ad9252f60055259a6/MT.js,requires-body=true

[MITM]
hostname = %APPEND% apimobile.meituan.com, feedguess.meituan.com, mop.meituan.com, mt-personalcenter.meituan.com, assistify.meituan.com

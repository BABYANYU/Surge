#!name=Single-Stream
#!desc=使用 Surge 当前实际出口进行 Ookla 单流下载测速，显示位置、下载速度、延迟、抖动和 HTTP 探测丢包率。
#!arguments=ping_count:6,warmup_seconds:0,test_seconds:8,max_download_gb:2,server_url:auto,update_interval:0
#!arguments-desc=ping_count：延迟探测次数；warmup_seconds：预热秒数；test_seconds：正式测速秒数；max_download_gb：最大下载流量（GB）；server_url：测速服务器，auto 为自动选择；update_interval：自动刷新间隔，0 为仅手动刷新。

[Script]
Single-Stream = type=generic, engine=webview, timeout=30, max-size=-1, script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/single-stream.js?v=3, script-update-interval=1, argument="ping_count={{{ping_count}}}&warmup_seconds={{{warmup_seconds}}}&test_seconds={{{test_seconds}}}&max_download_gb={{{max_download_gb}}}&server_url={{{server_url}}}"

[Panel]
Single-Stream = script-name=Single-Stream, title="Single-Stream", content="Tap refresh to start", icon=speedometer, icon-color=#5B9CF5, update-interval={{{update_interval}}}

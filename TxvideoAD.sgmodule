#!name=腾讯视频净化
#!desc=去除开屏广告、视频播放前广告、底部的多余 tap 栏、我的页面美化、我的界面顶部广告
#!author=TG@ZenMoFiShi
#!update=2026-11-1

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

[Script]
Txvideoad = type=http-request, pattern=^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$, script-path=http://script.hub/convert/_start_/https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js/_end_/Txvideoad.js?type=qx-script&target=surge-script&headers=, requires-body=true, max-size=-1, timeout=60

Txvideoad = type=http-response, pattern=^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$, script-path=http://script.hub/convert/_start_/https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js/_end_/Txvideoad.js?type=qx-script&target=surge-script&headers=, requires-body=true, max-size=-1, timeout=60

Txvideoad = type=http-response, pattern=^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$, script-path=http://script.hub/convert/_start_/https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js/_end_/Txvideoad.js?type=qx-script&target=surge-script&headers=, requires-body=true, max-size=-1, timeout=60

Txvideoad = type=http-response, pattern=^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$, script-path=http://script.hub/convert/_start_/https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js/_end_/Txvideoad.js?type=qx-script&target=surge-script&headers=, requires-body=true, max-size=-1, timeout=60

Txvideoad = type=http-response, pattern=^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$, script-path=http://script.hub/convert/_start_/https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js/_end_/Txvideoad.js?type=qx-script&target=surge-script&headers=, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com


#!name=YouTube Enhance
#!desc=移除 YouTube 广告，启用后台播放、画中画与最高 4 倍速；支持最高画质、Jump Ahead、内容精简和实验性原生下载。
#!author=gholts
#!arguments=block_upload:true,block_shorts:false,auto_hd:true,block_games:true,block_vertical_live:false,jump_ahead:true,block_store:true,native_download:false
#!arguments-desc=block_upload：隐藏 YouTube 导航栏中的“上传”入口。\nblock_shorts：隐藏 YouTube 导航栏中的 Shorts 入口。\nauto_hd：优先选择最高可用画质，并阻止自动降低画质。\nblock_games：隐藏 YouTube Playables 游戏推荐。\nblock_vertical_live：隐藏各页面中的竖屏直播推荐。\njump_ahead：启用 YouTube 原生“跳过精彩片段”按钮，同时移除相关推广。\nblock_store：隐藏视频下方及频道主页中的创作者商店和购物内容。\nnative_download：实验性原生下载；未指定画质时使用 720p，能否使用仍受服务器限制。
#!requirement=SYSTEM = 'iOS'
#!category=Yanyu宝宝小可爱
#!icon=https://raw.githubusercontent.com/BABYANYU/Surge/main/assets/yanyu-category.jpg

[Script]
youtube.enhance.ad-break = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/youtube-plus/request.js
youtube.enhance.download = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/offline\/get_download_action(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/youtube-plus/response.js,argument="{"nativeDownload":{{{native_download}}}}"
youtube.enhance.download-player = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/youtube-plus/request.js,argument="{"nativeDownload":{{{native_download}}}}"
youtube.enhance.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/youtube-plus/response.js,argument="{"blockUpload":{{{block_upload}}},"blockShorts":{{{block_shorts}}},"blockGames":{{{block_games}}},"blockVerticalLive":{{{block_vertical_live}}},"jumpAhead":{{{jump_ahead}}},"autoHd":{{{auto_hd}}},"blockStore":{{{block_store}}}}"
youtube.enhance.ump = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/youtube-plus/response.js,argument="{"blockGames":{{{block_games}}},"blockVerticalLive":{{{block_vertical_live}}},"jumpAhead":{{{jump_ahead}}},"autoHd":{{{auto_hd}}},"blockStore":{{{block_store}}}}"
youtube.enhance.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/youtube-plus/request.js
youtube.enhance.auto-hd = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/youtube-plus/request.js,argument="{"autoHd":{{{auto_hd}}}}"
youtube.enhance.log-event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/BABYANYU/Surge/main/scripts/youtube-plus/request.js

[URL Rewrite]
^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ - reject
^https:\/\/s\.youtube\.com\/api\/stats\/ads - reject

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, *.youtube.com
